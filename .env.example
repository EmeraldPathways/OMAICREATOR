# ---- Required for drafting ----
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o

# ---- Required for live web + news grounding ----
# SEARCH_PROVIDER accepts: tavily | serper | brave
SEARCH_PROVIDER=tavily
SEARCH_API_KEY=tvly-...

# ---- Injected automatically by the Neon integration in Vercel > Storage ----
# Do not set this by hand.
# DATABASE_URL=postgresql://...

# ---- Optional: HubSpot draft push ----
# HubSpot > Settings > Integrations > Private Apps > Create.
# Scopes: content, marketing-email
HUBSPOT_TOKEN=pat-...

# ---- Optional ----
# Set to "true" to let the Settings panel override keys at runtime (dev only).
ALLOW_RUNTIME_KEYS=false
